/ {
     chosen {
       zephyr,display = &ssd1306;
     };
     
     leds {
        compatible = "gpio-leds";
        in1: led_0 {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
            label = "LED 0";
        };
        in2: led_1 {
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
            label = "LED 1";
        };
        in3: led_2 {
            gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
            label = "LED 2";
        };
        in4: led_3 {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
            label = "LED 3";
        };
    };
        
    aliases {
    
      /* underscore not allowed in alias but in main.c
         its converted to in_1
      */
      in-1 = &in1;
      in-2 = &in2;
      in-3 = &in3;
      in-4 = &in4;
    };
};


&i2c0 {
    status = "okay";
    ssd1306: ssd1306@3c {
      	       compatible = "solomon,ssd1306";
	       reg = <0x3c>;
	       height = <64>;
	       width = <128>;
	       segment-offset = <0>;
	       page-offset = <0>;
	       display-offset = <0>;
	       multiplex-ratio = <63>;
	       prechargep = <0x22>;
	       com-invdir;
	       segment-remap;
      };
};
